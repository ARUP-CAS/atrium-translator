# atrium-translator — environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Per-run knobs (input paths, formats, vocabulary) live
# in config.txt instead; this file is for values that vary by DEPLOYMENT.
#
# HOW THIS FILE REACHES THE PROCESS — the distinction that used to bite:
#
#   docker compose    → delivered. Both services declare `env_file: .env`, so
#                       everything below is injected into the container. Compose
#                       ALSO reads this file for ${VAR} substitution, which is a
#                       different mechanism: substitution fills in the compose
#                       file, injection fills in the container. Until
#                       atrium-project#60 only substitution happened, so a
#                       LOG_LEVEL or MAX_UPLOAD_MB set here was read by nobody
#                       while this header claimed compose picked it up.
#   python -m service.api / python main.py
#                     → NOT delivered. Nothing in this repo calls load_dotenv();
#                       running outside a container, export the variables
#                       yourself (`set -a; . ./.env; set +a`).
#   Kubernetes        → NOT delivered. Use the manifest's own env: block. See
#                       ufal/atrium-project docs/k8s_deployment.md.
#
# A shell export beats this file for PORT, TRANSLATION_URL, UDPIPE_URL and the
# ATRIUM_* provenance values, which docker-compose.yml also lists explicitly
# because compose itself needs them; every other variable here comes from the
# file only.

# ── Backing services (atrium-project#63) ──────────────────────────────────────
# Attachable endpoints: point these at a self-hosted translation service or
# UDPipe 2, or at a local stub, with no code change. Leave BLANK (not deleted)
# to use the LINDAT defaults — blank means "unset" to every resolver, which is
# why docker-compose.yml passes them as ${VAR:-}.
#
# TRANSLATION_URL is the documented name; LINDAT_BASE_URL is accepted as an
# alias and loses to it when both are set. Whichever resolves is what
# /translate and the batch CLI record in the `translation_api` paradata field,
# so the record always names the host the request actually went to.
TRANSLATION_URL=
# Accepted alias for TRANSLATION_URL, kept for callers that already export it.
# TRANSLATION_URL wins when both are set. Prefer the name above.
# LINDAT_BASE_URL=
# Used for vocabulary lemma matching (Tag-and-Protect). Same variable name as
# atrium-nlp-enrich, which calls the same service for its own pipeline.
UDPIPE_URL=

# Which translation backend to load. `lindat` (CUBBITT) is the default;
# `openai_compatible` needs the LLM_* variables below. Shared with the CLI's
# --backend flag (issue #4).
TRANSLATION_BACKEND=lindat

# ── LLM backend (only when TRANSLATION_BACKEND=openai_compatible) ─────────────
# Connection. LLM_API_KEY is a SECRET: keep it out of the image (.env is in both
# .gitignore and .dockerignore) and out of the k8s manifest — use a Secret.
# LLM_BASE_URL=https://api.example.org/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_LANGUAGES=              # CSV of language codes this backend may handle

# Transport, same shape as the LINDAT dials below.
# LLM_MIN_INTERVAL_S=0.0      # minimum seconds between outbound requests
# LLM_MAX_RETRIES=4           # retries on network error / HTTP 429 / 5xx
# LLM_BACKOFF_BASE_S=1.0      # sleep = base * 2**attempt + jitter

# Generation and OCR-faithfulness guards. These bound what the model may return;
# a translation outside the length ratio is rejected rather than written into the
# XML, because a plausible-looking hallucination is worse than a failed chunk.
# LLM_MAX_TOKENS=2048         # per-chunk generation cap (anti-truncation)
# LLM_MAX_GLOSSARY_TERMS=40   # vocabulary terms injected into the prompt
# LLM_GUARD_MIN_CHARS=16      # below this length the ratio guards do not apply
# LLM_GUARD_MIN_RATIO=0.25    # reject output shorter than 0.25x the source
# LLM_GUARD_MAX_RATIO=4.0     # reject output longer than 4x the source

# ── CTranslate2 backend (self-hosted; scaffold, not registered by default) ────
# processors/ct2_translator.py is complete but deliberately not in
# processors/backend.py's registry — see docs/translation-backends.md. Listed
# here so the knobs are discoverable rather than only findable in the source.
# CT2_MODEL_DIR=              # path to the converted CTranslate2 model
# CT2_MODEL_FAMILY=eurollm    # eurollm | madlad | nllb
# CT2_SP_MODEL=               # SentencePiece model path, when the family needs one
# CT2_DEVICE=cpu              # cpu | cuda
# CT2_COMPUTE_TYPE=int4       # int4 keeps VRAM within a single consumer GPU
# CT2_LANGUAGES=              # CSV of language codes this backend may handle
# CT2_GUARD_MIN_CHARS=16      # as LLM_GUARD_* above
# CT2_GUARD_MIN_RATIO=0.25
# CT2_GUARD_MAX_RATIO=4.0

# ── LINDAT transport tuning ───────────────────────────────────────────────────
# These shape HOW the LINDAT endpoint is called, not WHICH one — they are named
# for the shared public service they were tuned against and are unrelated to
# TRANSLATION_URL above.
# LINDAT_MIN_INTERVAL_S=0.0   # minimum seconds between outbound requests
# LINDAT_MAX_RETRIES=4        # retries on network error / HTTP 429 / 5xx
# LINDAT_BACKOFF_BASE_S=1.0   # sleep = base * 2**attempt + jitter

# ── Image / provenance ────────────────────────────────────────────────────────
# These end up in every paradata record, which is how a translated document can
# be traced back to the exact image that produced it. ATRIUM_RUNNER_IMAGE and
# ATRIUM_RUNNER_REPO are Dockerfile ARGs baked at build time and re-declared in
# docker-compose.yml; override them only if you publish under another name.
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev
# ATRIUM_RUNNER_IMAGE=ghcr.io/ufal/atrium-translator:dev
# ATRIUM_RUNNER_REPO=https://github.com/ufal/atrium-translator
# Correlation id copied verbatim into paradata `request_id`. Read ONCE from the
# process environment at import, so it identifies a batch run, not an individual
# HTTP request — do not expect per-request correlation from it.
# ATRIUM_REQUEST_ID=

# Where the FastText language-ID model is cached. The Dockerfile sets this and
# docker-compose.yml mounts a named volume at it; without the volume the model is
# re-downloaded on every start and the service comes up DEGRADED on a host with
# no egress (see /health?deep=true).
# HF_HOME=/cache/huggingface

# ── HTTP surface ──────────────────────────────────────────────────────────────
# Port the api service binds, and the port service/healthcheck.py probes inside
# the container. docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}", so
# changing it here moves listener, published port and HEALTHCHECK together.
PORT=8000
# Bind address. Leave at 0.0.0.0: healthcheck.py always probes loopback and never
# reads HOST, so 127.0.0.1 gives a container that reports healthy and is
# unreachable from outside it.
HOST=0.0.0.0
# CORS for the api profile
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
# Canonical upload limit. MAX_UPLOAD_BYTES is a DEPRECATED fallback kept for
# older callers (service/atrium_service.py prefers the MB form) — set this one.
MAX_UPLOAD_MB=50
# DEPRECATED — do not set. Kept only so older callers that exported it still
# work; MAX_UPLOAD_MB wins whenever both are present. Listed here so the
# contract is complete and the deprecation is discoverable, not to offer a
# second knob.
# MAX_UPLOAD_BYTES=
# Path the container's HEALTHCHECK probes; change only alongside the route.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# Seconds uvicorn waits for in-flight requests on SIGTERM. A single /translate
# chunk can legitimately run for minutes; raise this together with the
# deployment's grace period (see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
# Root logger level for the `python -m service.api` start path
LOG_LEVEL=INFO
# Filesystem auto-reload — development only, never in a deployment
RELOAD=false
